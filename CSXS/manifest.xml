<?xml version="1.0" encoding="UTF-8"?>
<!-- InkStudio: a Procreate-like front over Illustrator. Panels only call Illustrator's own functions. -->
<ExtensionManifest Version="7.0" ExtensionBundleId="com.inkdraw.studio" ExtensionBundleVersion="0.1.0"
                   ExtensionBundleName="InkStudio" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
  <ExtensionList>
    <Extension Id="com.inkdraw.studio.library" Version="0.1.0"/>
    <Extension Id="com.inkdraw.studio.rail" Version="0.1.0"/>
  </ExtensionList>
  <ExecutionEnvironment>
    <HostList><Host Name="ILST" Version="[29.0,99.9]"/></HostList>
    <LocaleList><Locale Code="All"/></LocaleList>
    <RequiredRuntimeList><RequiredRuntime Name="CSXS" Version="9.0"/></RequiredRuntimeList>
  </ExecutionEnvironment>
  <DispatchInfoList>
    <Extension Id="com.inkdraw.studio.library">
      <DispatchInfo>
        <Resources>
          <MainPath>./library/index.html</MainPath>
          <ScriptPath>./jsx/host.jsx</ScriptPath>
          <CEFCommandLine><Parameter>--allow-file-access-from-files</Parameter><Parameter>--allow-file-access</Parameter></CEFCommandLine>
        </Resources>
        <Lifecycle><AutoVisible>true</AutoVisible></Lifecycle>
        <UI>
          <Type>Panel</Type>
          <Menu>InkStudio Brushes</Menu>
          <Geometry><Size><Width>420</Width><Height>760</Height></Size><MinSize><Width>300</Width><Height>300</Height></MinSize></Geometry>
        </UI>
      </DispatchInfo>
    </Extension>
    <Extension Id="com.inkdraw.studio.rail">
      <DispatchInfo>
        <Resources>
          <MainPath>./rail/index.html</MainPath>
          <ScriptPath>./jsx/host.jsx</ScriptPath>
        </Resources>
        <Lifecycle><AutoVisible>true</AutoVisible></Lifecycle>
        <UI>
          <Type>Panel</Type>
          <Menu>InkStudio Rail</Menu>
          <Geometry><Size><Width>100</Width><Height>620</Height></Size><MinSize><Width>100</Width><Height>300</Height></MinSize></Geometry>
        </UI>
      </DispatchInfo>
    </Extension>
  </DispatchInfoList>
</ExtensionManifest>
